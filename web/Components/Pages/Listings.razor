@page "/"
@using System.Text.Json
@inject ApiClient Api

<PageTitle>Listings</PageTitle>

@if (error is not null)
{
    <div class="notice error">@error</div>
}
else if (result is null)
{
    <p class="muted">Loading listings…</p>
}
else if (result.Listings.Count == 0)
{
    <div class="empty">
        <h1>No listings yet</h1>
        <p>Run a search and the results will appear here.</p>
        <a class="button" href="search">Start a search</a>
    </div>
}
else
{
    var shown = Filtered();
    var prices = shown.Where(l => l.RentPerWeek.HasValue).Select(l => l.RentPerWeek!.Value).Order().ToList();

    <div class="layout">
        <aside class="filters">
            <h2>Filter</h2>

            <label>Search
                <input type="search" placeholder="Street, suburb or agency" @bind="text" @bind:event="oninput" />
            </label>

            <label>Suburb
                <select @bind="suburb">
                    <option value="">All suburbs</option>
                    @foreach (var s in suburbs)
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </label>

            <label>Property type
                <select @bind="propertyType">
                    <option value="">Any type</option>
                    @foreach (var t in types)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </label>

            <div class="pair">
                <label>Min rent
                    <input type="number" min="0" placeholder="$" @bind="minPrice" />
                </label>
                <label>Max rent
                    <input type="number" min="0" placeholder="$" @bind="maxPrice" />
                </label>
            </div>

            <div class="pair">
                <label>Bedrooms at least
                    <input type="number" min="0" max="6" @bind="minBeds" />
                </label>
                <label>Bathrooms at least
                    <input type="number" min="0" max="6" @bind="minBaths" />
                </label>
            </div>

            <label>Available by
                <input type="date" @bind="availableBy" />
            </label>
            <p class="muted small hint">Listings with no available date count as available now.</p>

            <label>Landlord
                <select @bind="landlord">
                    <option value="">Agency or private</option>
                    <option value="agency">Agencies only</option>
                    <option value="private">Private landlords only</option>
                </select>
            </label>

            @if (hasFacebook)
            {
                <label>Source
                    <select @bind="source">
                        <option value="">Trade Me and Facebook</option>
                        <option value="trademe">Trade Me only</option>
                        <option value="facebook">Facebook only</option>
                    </select>
                </label>
            }

            <button class="link" @onclick="Reset">Clear filters</button>
        </aside>

        <section>
            <div class="toolbar">
                <div>
                    <h1>@shown.Count of @result.Listings.Count listings</h1>
                    <p class="muted">
                        @if (prices.Count > 0)
                        {
                            <text>Median $@(Median(prices).ToString("0")) a week, from $@(prices[0].ToString("0")) to $@(prices[prices.Count - 1].ToString("0")). </text>
                        }
                        @if (result.SearchedAt is { } at)
                        {
                            <text>Searched @at.ToLocalTime().ToString("d MMM yyyy, h:mm tt").</text>
                        }
                    </p>
                </div>
                <div class="controls">
                    <label>Sort
                        <select @bind="sort">
                            <option value="newest">Newest listed</option>
                            <option value="priceAsc">Rent, low to high</option>
                            <option value="priceDesc">Rent, high to low</option>
                            <option value="available">Available soonest</option>
                            <option value="beds">Most bedrooms</option>
                        </select>
                    </label>
                    <div class="segmented" role="group" aria-label="View">
                        <button class="@(view == "cards" ? "on" : "")" @onclick='() => view = "cards"'>Cards</button>
                        <button class="@(view == "table" ? "on" : "")" @onclick='() => view = "table"'>Table</button>
                    </div>
                </div>
            </div>

            @if (shown.Count == 0)
            {
                <p class="muted">Nothing matches these filters.</p>
            }
            else if (view == "cards")
            {
                <div class="grid">
                    @foreach (var l in shown)
                    {
                        <article class="card" @onclick="() => Open(l)">
                            <div class="photo">
                                @if (!string.IsNullOrEmpty(l.PictureHref))
                                {
                                    <img src="@l.PictureHref" alt="" loading="lazy" />
                                }
                            </div>
                            <div class="body">
                                <p class="price" title="@l.PriceNote"><strong>@Format.Rent(l)</strong>@if (l.RentPerWeek.HasValue){<span> per week</span>}</p>
                                <h3><button type="button" class="card-title">@(l.Address ?? l.Title)</button></h3>
                                <p class="muted">@Format.Place(l.Suburb, l.District)</p>
                                <ul class="facts">
                                    @if (l.IsFacebook) { <li class="source">Facebook</li> }
                                    @if (l.Bedrooms.HasValue) { <li>@Format.Beds(l.Bedrooms)</li> }
                                    @if (l.Bathrooms.HasValue) { <li>@Format.Baths(l.Bathrooms)</li> }
                                    @if (!string.IsNullOrEmpty(l.PropertyType)) { <li>@l.PropertyType</li> }
                                </ul>
                                <p class="small">
                                    @if (!string.IsNullOrEmpty(l.AvailableFrom)) { <text>Available @l.AvailableFrom. </text> }
                                    @Format.Ago(l.Listed, result.SearchedAt)
                                </p>
                                <p class="links" @onclick="NoOp" @onclick:stopPropagation>
                                    <a href="@l.SourceUrl" target="_blank" rel="noopener">Open on @l.SourceName</a>
                                    @if (l.MapUrl != "") { <a href="@l.MapUrl" target="_blank" rel="noopener">Map</a> }
                                </p>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Rent</th><th>Address</th><th>Suburb</th><th>Bed</th><th>Bath</th>
                                <th>Type</th><th>Available</th><th>Agency</th><th>Source</th><th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in shown)
                            {
                                <tr>
                                    <td class="num">@Format.Rent(l)</td>
                                    <td>@(l.Address ?? l.Title)</td>
                                    <td>@l.Suburb</td>
                                    <td class="num">@l.Bedrooms</td>
                                    <td class="num">@l.Bathrooms</td>
                                    <td>@l.PropertyType</td>
                                    <td>@l.AvailableFrom</td>
                                    <td>@(l.Agency?.Name)</td>
                                    <td>@l.SourceName</td>
                                    <td><a href="@l.SourceUrl" target="_blank" rel="noopener">Open</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>

    if (picked is not null)
    {
        <div class="modal-backdrop" @onclick="Close">
            <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" tabindex="-1"
                 @ref="modal" @onclick="NoOp" @onclick:stopPropagation @onkeydown="ModalKey">
                <div class="modal-head">
                    <div>
                        <p class="price"><strong>@Format.Rent(picked)</strong>@if (picked.RentPerWeek.HasValue){<span> per week</span>}</p>
                        @if (!string.IsNullOrEmpty(picked.PriceNote))
                        {
                            <p class="muted small">@picked.PriceNote</p>
                        }
                        <h2 id="modal-title">@(picked.Address ?? picked.Title)</h2>
                        <p class="muted">@Format.Place(picked.Suburb, picked.District, picked.Region)</p>
                    </div>
                    <button class="button" @onclick="Close">Close</button>
                </div>

                <p class="links">
                    <a href="@picked.SourceUrl" target="_blank" rel="noopener">Open on @picked.SourceName</a>
                    @if (picked.MapUrl != "") { <a href="@picked.MapUrl" target="_blank" rel="noopener">Map</a> }
                </p>

                @if (picked.PhotoUrls is { Count: > 0 } photos)
                {
                    <div class="gallery">
                        @foreach (var photo in photos)
                        {
                            <a href="@photo" target="_blank" rel="noopener"><img src="@photo" alt="" loading="lazy" /></a>
                        }
                    </div>
                }

                <h3 class="fields-title">All scraped fields <span class="muted">(@fields.Count)</span></h3>
                <p class="muted small">The same fields as listings.csv. Photo URLs are shown as the pictures above.</p>
                <div class="table-wrap">
                    <table class="fields">
                        <tbody>
                            @foreach (var field in fields)
                            {
                                <tr>
                                    <th scope="row">@field.Key</th>
                                    <td>
                                        @if (field.Value == "")
                                        {
                                            <span class="muted">empty</span>
                                        }
                                        else if (field.Value.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <a href="@field.Value" target="_blank" rel="noopener">@field.Value</a>
                                        }
                                        else
                                        {
                                            <span>@field.Value</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

@code {
    private ListingsResult? result;
    private string? error;
    private List<string> suburbs = [];
    private List<string> types = [];

    private string text = "";
    private string suburb = "";
    private string propertyType = "";
    private int? minPrice, maxPrice, minBeds, minBaths;
    private DateTime? availableBy;
    private string landlord = "";
    private string source = "";
    private bool hasFacebook;
    private string sort = "newest";
    private string view = "cards";

    private Listing? picked;
    private List<KeyValuePair<string, string>> fields = [];
    private ElementReference modal;
    private bool focusModal;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            result = await Api.GetListingsAsync();
            suburbs = result.Listings.Select(l => l.Suburb).OfType<string>().Where(s => s != "").Distinct().Order().ToList();
            types = result.Listings.Select(l => l.PropertyType).OfType<string>().Where(s => s != "").Distinct().Order().ToList();
            hasFacebook = result.Listings.Any(l => l.IsFacebook);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
    }

    private static bool HasAgency(Listing l) => !string.IsNullOrWhiteSpace(l.Agency?.Name);

    private List<Listing> Filtered()
    {
        var q = result!.Listings.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(text))
        {
            var needle = text.Trim();
            q = q.Where(l => $"{l.Title} {l.Address} {l.Suburb} {l.Agency?.Name}"
                .Contains(needle, StringComparison.OrdinalIgnoreCase));
        }
        if (suburb != "") q = q.Where(l => l.Suburb == suburb);
        if (propertyType != "") q = q.Where(l => l.PropertyType == propertyType);
        if (minPrice is { } lo) q = q.Where(l => l.RentPerWeek >= lo);
        if (maxPrice is { } hi) q = q.Where(l => l.RentPerWeek <= hi);
        if (minBeds is { } b) q = q.Where(l => l.Bedrooms >= b);
        if (minBaths is { } baths) q = q.Where(l => l.Bathrooms >= baths);
        if (availableBy is { } by) q = q.Where(l => l.AvailableDate is not { } d || d.Date <= by.Date);
        if (landlord == "agency") q = q.Where(HasAgency);
        if (landlord == "private") q = q.Where(l => !HasAgency(l));
        if (source == "facebook") q = q.Where(l => l.IsFacebook);
        if (source == "trademe") q = q.Where(l => !l.IsFacebook);
        return Sort(q).ToList();
    }

    private IEnumerable<Listing> Sort(IEnumerable<Listing> items) => sort switch
    {
        "priceAsc" => items.OrderBy(l => l.RentPerWeek ?? decimal.MaxValue),
        "priceDesc" => items.OrderByDescending(l => l.RentPerWeek ?? 0),
        "available" => items.OrderBy(l => l.AvailableDate ?? DateTime.MaxValue),
        "beds" => items.OrderByDescending(l => l.Bedrooms ?? 0),
        _ => items.OrderByDescending(l => l.Listed ?? DateTimeOffset.MinValue),
    };

    private static decimal Median(List<decimal> sorted)
    {
        var mid = sorted.Count / 2;
        return sorted.Count % 2 == 1 ? sorted[mid] : (sorted[mid - 1] + sorted[mid]) / 2;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusModal)
        {
            focusModal = false;
            await modal.FocusAsync(); // so Escape works straight away
        }
    }

    private void Open(Listing listing)
    {
        picked = listing;
        fields = listing.Raw.ValueKind == JsonValueKind.Undefined
            ? []
            : Format.Flatten(listing.Raw).Where(f => !f.Key.StartsWith("photoUrls[")).ToList();
        focusModal = true;
    }

    private void Close() => picked = null;

    private void NoOp() { }

    private void ModalKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Close();
    }

    private void Reset()
    {
        text = suburb = propertyType = landlord = source = "";
        minPrice = maxPrice = minBeds = minBaths = null;
        availableBy = null;
    }
}
